# Project: 1000 cloud configuration. Copy to .env (never commit .env).
# Values come from Supabase Dashboard → Project Settings → API.

# Safe to ship in the phone and web apps (row-level security protects data).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<publishable-anon-key>

# NEVER put this in the phone app, the web bundle or git. Not needed by
# any client; only for admin scripts you run yourself, if ever.
# SUPABASE_SERVICE_ROLE_KEY=

# Local tests only (see docs/CLOUD.md).
# TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
