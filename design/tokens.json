{
  "$description": "Project: 1000 design tokens, taken from lib/ui/theme.dart. The web app reads these; test/design_tokens_test.dart keeps them equal to the Flutter theme.",
  "brand": {
    "green": "#6DBE5A",
    "deepGreen": "#3F7A35",
    "purple": "#3B1F4A",
    "blush": "#F07A6A",
    "wall": "#29302E",
    "paper": "#FBF8F1"
  },
  "color": {
    "light": {
      "primary": "#3F7A35",
      "secondary": "#3B1F4A",
      "tertiary": "#F07A6A",
      "surface": "#FBF8F1",
      "surfaceContainerLowest": "#FFFFFF",
      "surfaceContainerLow": "#F5F1E7",
      "surfaceContainer": "#EFEADF"
    },
    "dark": {
      "primary": "#8FD67C",
      "secondary": "#CDB4DB",
      "tertiary": "#F07A6A",
      "surface": "#1C2120",
      "surfaceContainerLowest": "#171B1A",
      "surfaceContainerLow": "#222826",
      "surfaceContainer": "#272E2C"
    },
    "note": "Other roles (onSurface, outlineVariant, error…) come from Material 3 ColorScheme.fromSeed(seed: brand.green); generate them on the web with @material/material-color-utilities using the same seed."
  },
  "font": {
    "display": { "family": "Fredoka", "file": "assets/fonts/Fredoka.ttf", "lineHeight": 1.1, "defaultWeight": 600 },
    "body": { "family": "system", "note": "Flutter's platform default (Roboto on Android); use the system UI stack on the web." },
    "scale": { "appBarTitle": 22, "button": 16 }
  },
  "radius": { "card": 18, "fab": 18, "input": 14, "button": 14, "chip": 10 },
  "spacing": {
    "buttonPadding": [22, 14],
    "inputPadding": [16, 14]
  },
  "elevation": { "card": 0, "appBarScrolledUnder": 0.5, "cardBorderAlpha": 0.5 }
}
